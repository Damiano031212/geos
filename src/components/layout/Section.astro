---
/** Sezione di pagina: ancora con offset sotto la navbar (`scroll-margin-top`). */
interface Props {
  id?: string;
  class?: string;
  labelledby?: string;
}

const { id, class: className = '', labelledby } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class:list={['section', className]}>
  <slot />
</section>
