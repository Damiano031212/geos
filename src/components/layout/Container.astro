---
/**
 * Container della griglia (docs/design-system.md §5).
 * cols=12 → colonne 1–12, cols=10 → colonne 2–11, cols=8 → colonne 3–10.
 * Sotto 1024 i tre container coincidono (margini a piena larghezza).
 */
interface Props {
  cols?: 12 | 10 | 8;
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav' | 'article';
  class?: string;
}

const { cols = 12, as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['grid-container', `grid-container--${cols}`, className]}>
  <div class="grid-container__inner">
    <slot />
  </div>
</Tag>
