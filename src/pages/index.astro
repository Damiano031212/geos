---
import Base from '../components/layout/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import ForWhom from '../components/sections/ForWhom.astro';
import Numbers from '../components/sections/Numbers.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Suite from '../components/sections/Suite.astro';
import Plans from '../components/sections/Plans.astro';
import DemoForm from '../components/sections/DemoForm.astro';
import FinalCta from '../components/sections/FinalCta.astro';

// TODO(geos): title e meta description definitivi (bozza da validare).
---

<Base title="Geos">
  <Navbar slot="header" />
  <Hero />
  <ForWhom />
  <Numbers />
  <Features />
  <HowItWorks />
  <Suite />
  <Plans />
  <DemoForm />
  <div slot="footer" class="closing">
    <FinalCta />
    <Footer />
  </div>
</Base>
